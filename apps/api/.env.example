# ==============================================================================
# Career Companion API Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (100% Free & Open-Source)
# ------------------------------------------------------------------------------
# Option A: Free Local SQLite (Default - Zero setup needed)
DATABASE_URL=sqlite+aiosqlite:///./career_companion.db

# Option B: Free Cloud PostgreSQL via Neon (https://neon.tech - 100% open-source Postgres, generous free tier forever)
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option C: Free Cloud PostgreSQL via Supabase (https://supabase.com - Open-source Postgres free tier)
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xyz.supabase.co:5432/postgres

# Option D: Free Local PostgreSQL instance
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_companion

# ------------------------------------------------------------------------------
# 2. JOB SEARCH API KEYS (Optional Free Tier Integrations)
# ------------------------------------------------------------------------------
# RapidAPI JSearch key (Free tier: 500 requests/month): https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
JSEARCH_API_KEY=

# Adzuna API (Free forever: 250 requests/day): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ------------------------------------------------------------------------------
# 3. AI / LLM (Optional)
# ------------------------------------------------------------------------------
# OpenAI API key (If not provided, built-in algorithmic AI heuristic engine is used automatically)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. STORAGE
# ------------------------------------------------------------------------------
UPLOADS_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
